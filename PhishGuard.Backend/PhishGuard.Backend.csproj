<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Habilita user-secrets em dev local (segredo do JWT fora do controle de versão). -->
    <UserSecretsId>phishguard-backend-tg2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.1.973" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="QuestPDF" Version="2026.7.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Corpos HTML das iscas oficiais resolvidos por ID no disparo (OfficialBaitCatalog).
         Incluídos EXPLICITAMENTE (um por arquivo) para garantir o embutimento de cada
         recurso — em especial 'amazon-notificacao-seguranca.html'. Ao adicionar uma nova
         isca, inclua a linha correspondente aqui. -->
    <EmbeddedResource Include="Resources\OfficialBaits\hbomax-redefinicao-senha.html" />
    <EmbeddedResource Include="Resources\OfficialBaits\netflix-atualizacao-cobranca.html" />
    <EmbeddedResource Include="Resources\OfficialBaits\amazon-notificacao-geral.html" />
    <EmbeddedResource Include="Resources\OfficialBaits\amazon-notificacao-seguranca.html" />
    <EmbeddedResource Include="Resources\OfficialBaits\microcorp-expiracao-senha.html" />
    <EmbeddedResource Include="Resources\OfficialBaits\mercadoliv-novo-acesso.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logos rasterizadas (PNG) anexadas via CID (inline) no disparo. O Gmail NÃO
         renderiza SVG nem data-URI, mas exibe anexos inline (Content-ID) por padrão,
         sem o "exibir imagens". Resolvidas por token em EmailLogoCatalog. -->
    <EmbeddedResource Include="Resources\EmailAssets\bho-max-logo.png" />
    <EmbeddedResource Include="Resources\EmailAssets\mercado-liv-logo.png" />
  </ItemGroup>

</Project>
