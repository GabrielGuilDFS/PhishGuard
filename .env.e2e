# ============================================================================
# .env de HOMOLOGAÇÃO (E2E) — Passo 13. Valores de TESTE, sem segredos reais.
# Consumido por docker-compose.e2e.yml (--env-file .env.e2e) e, opcionalmente,
# exportado no host antes de rodar o Playwright (as vars E2E_* têm defaults nos
# helpers, então exportá-las é só para sobrescrever).
#
# Isolamento (§2.1): SMTP SEMPRE no Mailpit; PublicAppBaseUrl no host de teste;
# allowlist @test.io no backend garante que nenhum e-mail escape mesmo se o SMTP
# for trocado por engano. NADA aqui sai para a internet.
# ============================================================================

# ── Postgres (banco efêmero de homologação) ──────────────────────────────────
POSTGRES_DB=phishguard_e2e
POSTGRES_USER=postgres
POSTGRES_PASSWORD=e2e
POSTGRES_PORT=5433

# ── Segredo do JWT (HMAC) — chave DE TESTE, descartável ──────────────────────
AppSettings__Token=e2e-homolog-only-nao-use-em-producao-0123456789abcdef0123456789abcdef

# ── URLs públicas (host de teste). 1 origem: o Vite reverte /api para o backend ─
# Os links dos e-mails e os redirects de rastreamento apontam para o app de teste.
AppSettings__PublicApiBaseUrl=http://localhost:5173
AppSettings__PublicAppBaseUrl=http://localhost:5173
AppSettings__AllowedCorsOrigins__0=http://localhost:5173

# ── SMTP de homologação → Mailpit (capturado, nunca sai) ─────────────────────
# StartTlsWhenAvailable: fala com o Mailpit (SMTP em texto puro na 1025) sem mudar
# o disparo real (Gmail 587 continua anunciando STARTTLS e sendo criptografado).
AppSettings__SmtpSecureSocketOptions=StartTlsWhenAvailable
# Allowlist de destino (§2.1d): só entrega para @test.io; o resto vira "Falha".
AppSettings__OutboundEmailAllowedDomains=test.io
# Sem throttle entre envios — acelera o E2E.
AppSettings__SmtpThrottleMs=0

# ── Coordenadas usadas pelo Playwright/helpers (host). Defaults nos helpers. ──
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:5173/api
E2E_MAILPIT_URL=http://localhost:8025
E2E_TEST_DOMAIN=test.io
# SMTP que o spec grava no SmtpConfig do tenant (rede interna do compose).
E2E_SMTP_HOST=mailpit
E2E_SMTP_PORT=1025
