# ============================================================================
# PhishGuard — TEMPLATE de variaveis de ambiente.
#
# COMO USAR (primeira vez, em qualquer PC):
#   cp .env.example .env      # (Windows PowerShell: Copy-Item .env.example .env)
#   # edite o .env e preencha os segredos abaixo
#   docker compose up -d --build
#
# O arquivo .env real e GITIGNORED (nunca vai para o repositorio) — cada
# desenvolvedor tem o seu. Este .env.example e o CONTRATO: lista toda chave que o
# projeto espera. Ao adicionar uma variavel nova ao compose, documente-a AQUI.
# ============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=phishguard_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-me-senha-do-banco

# Porta do Postgres no HOST. Fonte UNICA de verdade — mude SO aqui e o compose
# inteiro acompanha (container, mapeamento de porta e connection string).
# Default 5433 (nao 5432) de proposito: evita conflito com um Postgres ja
# instalado na 5432 da sua maquina. Padronize: use SEMPRE o banco do Docker,
# nunca o Postgres nativo do host — assim a porta nunca diverge entre PCs.
POSTGRES_PORT=5433

# ── Segredo do JWT (HMAC-SHA512) ─────────────────────────────────────────────
# Gere uma chave longa e aleatoria (>= 64 chars). NUNCA versione a real.
AppSettings__Token=troque-esta-chave-por-uma-string-aleatoria-longa-de-pelo-menos-64-caracteres

# ── Exposicao publica via ngrok (OPCIONAL) ───────────────────────────────────
# So necessario para expor o app na internet (alvos clicando de caixas reais,
# ex. Gmail). Para dev/demonstracao local, pode deixar em branco.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
