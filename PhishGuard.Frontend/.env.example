# ============================================================================
# Frontend (Vite) — TEMPLATE de variaveis de ambiente.
#
# COMO USAR: cp .env.example .env  (o .env real e gitignored). Vite so expoe ao
# client variaveis com prefixo VITE_. Reinicie o `npm run dev` apos alterar.
# ============================================================================

# O browser sempre usa /api no mesmo host do frontend. Isso permite que o cookie
# HttpOnly de refresh sobreviva ao F5 sem depender de CORS/SameSite entre hosts.
VITE_API_BASE_URL=/api

# Destino interno do proxy Vite. Em dev local, o backend roda no host em :5000.
# O docker-compose sobrescreve para http://backend:5000.
VITE_API_PROXY_TARGET=http://localhost:5000
